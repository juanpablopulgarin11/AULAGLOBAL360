# Copiar a .env y ajustar. Sin .env se usa SQLite y Celery síncrono.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://usuario:clave@localhost:5432/aulaglobal360
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AULA360_DIAS_RETENCION_VIDEO=30

# Producción con docker compose (ver docker-compose.yml)
# DJANGO_SETTINGS_MODULE=config.settings.prod
# POSTGRES_PASSWORD=
# AULA360_POSE_GPU=false            # Linux sin GPU; en macOS mediapipe solo funciona con GPU
# AULA360_MAX_SUBIDA_MB=60
